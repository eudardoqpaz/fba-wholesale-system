# ============================================
# Amazon FBA Wholesale System - Configuration
# ============================================
# Copy this file to .env and fill in your values

# Amazon SP-API Credentials
# Get these from https://developer-docs.amazon.com/sp-api/
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SELLER_ID=YOUR_SELLER_ID
AMAZON_SP_API_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
AMAZON_SP_API_CLIENT_ID=YOUR_CLIENT_ID
AMAZON_SP_API_CLIENT_SECRET=YOUR_CLIENT_SECRET
AMAZON_SP_API_ACCESS_KEY=YOUR_ACCESS_KEY
AMAZON_SP_API_SECRET_KEY=YOUR_SECRET_KEY
AMAZON_SP_API_ROLE_ARN=YOUR_ROLE_ARN

# Keepa API Key (optional but recommended)
# Get from https://keepa.com/#!api
KEEPA_API_KEY=YOUR_KEEPA_API_KEY

# MiMo AI API (for AI Advisor)
# Get from https://platform.xiaomimimo.com
MIMO_API_KEY=your-mimo-api-key
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite+aiosqlite:///./fba_system.db

# Email Settings (for reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
REPORT_EMAIL=your-email@gmail.com
